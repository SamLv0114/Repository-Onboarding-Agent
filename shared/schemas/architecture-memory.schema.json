{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository Architecture Memory — proposed v0.2",
  "type": "object",
  "required": [
    "repository_id",
    "snapshot_id",
    "claims"
  ],
  "properties": {
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "description": "Git commit hash for generated memory; fixtures may use a placeholder"
    },
    "build_cost": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "model",
        "elapsed_s"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "elapsed_s": {
          "type": "number",
          "minimum": 0
        },
        "llm_calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "title",
          "text",
          "status",
          "evidence"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "level": {
            "enum": [
              "repository",
              "file"
            ]
          },
          "status": {
            "enum": [
              "valid",
              "stale",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "start_line",
                "end_line"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "content_hash": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "SHA-256 of the cited lines when the memory was built"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
