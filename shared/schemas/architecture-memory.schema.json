{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository Architecture Memory \u2014 proposed v0.1",
  "type": "object",
  "required": [
    "repository_id",
    "snapshot_id",
    "claims"
  ],
  "properties": {
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "title",
          "text",
          "status",
          "evidence"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "valid",
              "stale",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "start_line",
                "end_line"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
